{
  "_manifest": {
    "urn": "urn:dev:agent-bootstrap:steipete-config:1.6.0",
    "type": "bootstrap_config"
  },
  "allowed_kb": [
    "urn:dev:kb:agentic-engineering-praxis",
    "urn:dev:kb:agentic-tooling-inventory"
  ],
  "sandbox": {
    "mode": "permissive"
  },
  "tools": {
    "allow": [
      "cancel_worker",
      "catalog_resolve",
      "dispatch_worker",
      "monitor_workers",
      "read_codebase",
      "review_diff",
      "search_kb",
      "search_openclaw",
      "search_tooling"
    ],
    "deny": []
  },
  "model_routing": {
    "defaults": {
      "implementation": { "cli": "claude-code", "model": "opus-4.6" },
      "refactoring": { "cli": "claude-code", "model": "opus-4.6" },
      "review": { "cli": "codex", "model": "gpt-5.4" },
      "bugfix_simple": { "cli": "claude-code", "model": "sonnet-4.6" },
      "bulk_repetitive": { "cli": "opencode", "model": "deepseek-v3.2" }
    },
    "policy": "search_tooling para seleccion dinamica; defaults como fallback"
  },
  "runtime_capabilities": {
    "allow": [
      "code_execution"
    ],
    "deny": [
      "sub_agent_spawn",
      "web_search"
    ]
  },
  "limits": {
    "max_tokens": 8000,
    "max_response_time_ms": 60000,
    "max_worker_retries": 2
  }
}
