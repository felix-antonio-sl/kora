// Template: openclaw.json5 completo para agente KORA transmutado
// Fuente: urn:ops:kb:deploy-agente-kora-en-openclaw §3.4c
// Parametrizar valores entre {llaves} antes de usar
{
  agents: {
    defaults: {
      workspace: "/home/node/.openclaw/workspace",
      model: { primary: "{model_routing_tier_default}" },
      models: {
        "{model_routing_tier_default}": {
          params: {
            cacheRetention: "long",  // cache de bootstrap ~1h
            // context1m: true,      // Solo con API key directa, NO con OAuth/setup-token
          },
        },
      },
      memorySearch: { enabled: false },  // activar solo si hay embedding provider
    },
    list: [
      {
        id: "{namespace}-{nombre}",
        default: true,
        identity: {
          name: "{nombre_legible}",
          theme: "{tema_derivado_de_soul}",
          emoji: "{emoji}",
        },
        // sandbox, tools, subagents: descomentar si difieren del default
        // sandbox: { mode: "{sandbox_mode}" },
        // tools: { allow: [...], deny: [...] },
        // subagents: { maxSpawnDepth: {max_depth}, maxChildrenPerAgent: {max_concurrent} },
      }
    ],
  },
  session: { scope: "per-sender" },
  gateway: {
    mode: "local",
    port: {puerto_base},               // espaciar minimo 20 entre gateways (P7)
    bind: "loopback",                   // "auto"|"lan"|"loopback"|"custom"|"tailnet"
    controlUi: { enabled: true, basePath: "/openclaw" },
    auth: { mode: "token" },
  },
  channels: {
    telegram: {
      enabled: true,
      dmPolicy: "allowlist",
      allowFrom: [{telegram_user_id}],  // INTEGER sin comillas, de @userinfobot
      groupPolicy: "disabled",
      streaming: "partial",
      ackReaction: "{emoji}",
      reactionLevel: "minimal",
      linkPreview: false,
      textChunkLimit: 4000,
      chunkMode: "newline",
    },
    // discord, whatsapp, etc: descomentar segun canal requerido
  },
}
