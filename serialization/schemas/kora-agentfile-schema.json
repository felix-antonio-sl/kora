{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KORA Agentfile Frontmatter Schema v2 (LEGACY COMPAT ONLY)",
  "description": "Schema historico para compatibilidad/migracion de agentfile-spec v2.0.0. No es authoring canonico productivo; el shape vigente es serialization/schemas/kora-artefacto.json + autoria-spec. Acepta shape v1/v2 legacy con extensions.kora.harness_vector para permitir migracion a extensions.kora.vector_ontologico.",
  "type": "object",
  "required": ["_manifest", "version", "name", "status", "tags", "lang", "extensions", "agent"],
  "properties": {
    "_manifest": {
      "type": "object",
      "required": ["urn", "provenance"],
      "properties": {
        "urn": {
          "type": "string",
          "pattern": "^urn:[a-z][a-z0-9]*:agent:[a-z][a-z0-9-]*$"
        },
        "provenance": {
          "type": "object",
          "required": ["created_by", "created_at"],
          "properties": {
            "created_by": { "type": "string", "minLength": 1 },
            "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "source": { "type": "string" }
          }
        }
      }
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "enum": ["draft", "active", "deprecated", "retired"]
    },
    "updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "deprecated_by": { "type": "string" },
    "retirement_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "lang": {
      "type": "string",
      "pattern": "^[a-z]{2}$"
    },
    "extensions": {
      "type": "object",
      "properties": {
        "kora": {
          "type": "object",
          "properties": {
            "harness_vector": {
              "$ref": "#/$defs/harness_vector"
            },
            "presentation": {
              "enum": ["state-primary", "action-primary"]
            },
            "atlas": {
              "type": "object",
              "properties": {
                "harness_name": {
                  "enum": ["utilidad", "disciplina", "delegado", "persona", "orquestador", "servicio", "arquetipo"]
                },
                "form": {
                  "enum": ["skill-standard", "subagent", "agent-proper", "platform-agent", "archetype"]
                },
                "hcai_metaphor": {
                  "enum": ["supertool", "tele-bot", "active-appliance", "control-center"]
                }
              }
            },
            "legacy_coexistence": { "type": "string" },
            "composable_with": {
              "type": "array",
              "items": { "type": "string" }
            },
            "allowed_kb": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "agent": {
      "type": "object",
      "oneOf": [
        { "$ref": "#/$defs/agent_v2" },
        { "$ref": "#/$defs/agent_v1_legacy" }
      ]
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "pattern": "^CM-[A-Z][A-Z0-9-]*$" },
          "required": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "harness_vector": {
      "type": "object",
      "required": ["pi", "mu", "xi", "lambda", "phi", "sigma"],
      "properties": {
        "pi": { "type": "integer", "minimum": 0, "maximum": 3 },
        "mu": { "type": "integer", "minimum": 0, "maximum": 3 },
        "xi": { "type": "integer", "minimum": 0, "maximum": 4 },
        "lambda": { "type": "integer", "minimum": 0, "maximum": 3 },
        "phi": { "type": "integer", "minimum": 0, "maximum": 4 },
        "sigma": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "type": "integer", "minimum": 0, "maximum": 3 }
        }
      }
    },
    "agent_v2": {
      "type": "object",
      "required": ["profile", "plan"],
      "description": "Shape v2: profile (antes coalgebra), context (antes fibers), invariants (bifurca safety).",
      "properties": {
        "profile": {
          "type": "object",
          "required": ["description", "domain"],
          "properties": {
            "description": { "type": "string", "minLength": 10 },
            "domain": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            },
            "triggers": {
              "type": "array",
              "items": { "type": "string" }
            },
            "outputs": {
              "type": "array",
              "items": { "type": "string" }
            },
            "narrative": { "type": "string" }
          }
        },
        "plan": { "$ref": "#/$defs/plan" },
        "interface": { "$ref": "#/$defs/interface" },
        "context": {
          "type": "object",
          "properties": {
            "memory_config": {
              "type": "object",
              "properties": {
                "mode": { "enum": ["stateless", "session", "persistent", "ambient"] },
                "storage": { "type": "string" }
              }
            },
            "operator_profile": {
              "type": "object",
              "properties": {
                "role": { "type": "string" },
                "context": { "type": "string" }
              }
            },
            "kb_refs": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "composition": { "$ref": "#/$defs/composition" },
        "invariants": {
          "type": "object",
          "properties": {
            "hard_rules": { "type": "object" },
            "co_induction": { "type": "object" },
            "guardrails": {
              "type": "array",
              "items": { "type": "string" }
            },
            "alignment": {
              "type": "object",
              "properties": {
                "principal": { "type": "string" },
                "contract": { "type": "string" }
              }
            },
            "ethical_commitments": {
              "type": "object",
              "description": "Desarrollo en prosa de Σ; debe ser consistente con harness_vector.sigma",
              "properties": {
                "safety_norm": { "type": "string" },
                "fairness": { "type": "string" },
                "transparency": { "type": "string" },
                "accountability": { "type": "string" },
                "sustainability": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "agent_v1_legacy": {
      "type": "object",
      "required": ["coalgebra", "plan"],
      "description": "Shape v1 legacy: acepta coalgebra/fibers/safety durante transicion a v2. Emite warning al lint.",
      "properties": {
        "coalgebra": {
          "type": "object",
          "required": ["description", "domain"],
          "properties": {
            "description": { "type": "string", "minLength": 10 },
            "domain": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            },
            "triggers": { "type": "array", "items": { "type": "string" } },
            "outputs": { "type": "array", "items": { "type": "string" } },
            "invariants": { "type": "array", "items": { "type": "string" } }
          }
        },
        "plan": { "$ref": "#/$defs/plan" },
        "interface": { "$ref": "#/$defs/interface" },
        "fibers": {
          "type": "object",
          "properties": {
            "identity": { "type": "object" },
            "operator": { "type": "object" },
            "memory": { "type": "object" },
            "runtime": { "type": "object" },
            "knowledge": { "type": "object" }
          }
        },
        "composition": { "$ref": "#/$defs/composition" },
        "safety": {
          "type": "object",
          "properties": {
            "hard_rules": { "type": "object" },
            "co_induction": { "type": "object" },
            "guardrails": { "type": "array" },
            "alignment": { "type": "object" }
          }
        }
      }
    },
    "plan": {
      "type": "object",
      "required": ["initial_state", "terminal_state", "states"],
      "properties": {
        "initial_state": { "type": "string", "pattern": "^S-[A-Z][A-Z0-9_]*$" },
        "terminal_state": { "type": "string", "pattern": "^S-[A-Z][A-Z0-9_]*$" },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "act"],
            "properties": {
              "id": { "type": "string", "pattern": "^S-[A-Z][A-Z0-9_]*$" },
              "act": { "type": "string", "minLength": 1 },
              "transitions": {
                "oneOf": [
                  { "const": "terminal" },
                  {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["condition", "target", "priority"],
                      "properties": {
                        "condition": { "type": "string" },
                        "target": { "type": "string", "pattern": "^S-[A-Z][A-Z0-9_]*$" },
                        "priority": { "type": "integer", "minimum": 1 }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "interface": {
      "type": "object",
      "properties": {
        "tools": {
          "type": "array",
          "items": { "type": "object" }
        },
        "permissions": {
          "type": "object",
          "properties": {
            "allow": { "type": "array", "items": { "type": "string" } },
            "deny": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "composition": {
      "type": "object",
      "properties": {
        "type": { "enum": ["root", "sub-agent", "peer"] },
        "sub_agents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["urn", "role"]
          }
        },
        "golden_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "circuit_breakers": {
          "type": "array",
          "items": { "type": "object" }
        },
        "event_routing": { "type": "object" },
        "delegation": {
          "type": "object",
          "properties": {
            "max_depth": { "type": "integer", "minimum": 0 },
            "dissipation": { "type": "object" }
          }
        }
      }
    }
  }
}
