#!/usr/bin/env sh
set -eu

needs_master_check=0

while read local_ref local_sha remote_ref remote_sha
do
  if [ "${remote_ref:-}" = "refs/heads/master" ]; then
    needs_master_check=1
  fi
done

if [ "$needs_master_check" -eq 0 ]; then
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
export PYTHONPATH="$repo_root/toolchain${PYTHONPATH:+:$PYTHONPATH}"

python3 -c 'from kora_lib.host import pre_push_master_guard; raise SystemExit(pre_push_master_guard())'
